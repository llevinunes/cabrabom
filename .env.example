# Copie para .env.local e preencha.
# SUPABASE_URL e SUPABASE_SERVICE_ROLE_KEY: rode `npx supabase status -o env`
# e copie API_URL e SERVICE_ROLE_KEY. A service_role key só é usada no servidor.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=

# Endereço público do app (usado nos links enviados pelo WhatsApp).
APP_URL=http://localhost:3000

# Segredo para assinar cookies que o servidor precisa confiar (mínimo 32 caracteres).
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
COOKIE_SECRET=

# Número de WhatsApp do CabraBom, só dígitos (55 + DDD + número).
# Em desenvolvimento, qualquer número serve: o login usa o simulador em /dev/whatsapp.
WHATSAPP_CABRABOM_NUMBER=5583900000000

# Webhook da WhatsApp Cloud API (opcionais em desenvolvimento).
WHATSAPP_VERIFY_TOKEN=
META_APP_SECRET=

# Só para os testes de segurança (npm run test:db): ANON_KEY de `npx supabase status -o env`.
SUPABASE_ANON_KEY=
